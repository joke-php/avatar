# Настройки атрибутов Git для модуля joke-avatar

# Автоматически нормализовать окончания строк
* text=auto

# PHP-файлы
*.php text diff=php

# Markdown
*.md text diff=markdown

# JSON
*.json text

# Конфигурационные файлы
*.yml text
*.yaml text
*.neon text

# Изображения (не текстовые)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary

# Архивы
*.zip binary
*.tar.gz binary

# Игнорировать экспорт dev-зависимостей, документации и тестового приложения
/.gitattributes export-ignore
/.gitignore export-ignore
/composer.lock export-ignore
/TODO.md export-ignore
/plans/ export-ignore
/frm/ export-ignore
/docker/ export-ignore
/public/ export-ignore
/var/ export-ignore
/bootstrap/ export-ignore
/routes/ export-ignore
/config/ export-ignore
/tests/ export-ignore
/.php-cs-fixer.php export-ignore
/.phpstan.neon.dist export-ignore
/phpunit.xml export-ignore
/CHANGELOG.md export-ignore