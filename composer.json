{
    "name": "voral/joke-avatar",
    "description": "\u041c\u043e\u0434\u0443\u043b\u044c \u0434\u043b\u044f \u0444\u0440\u0435\u0439\u043c\u0432\u043e\u0440\u043a\u0430 Joke \u043f\u043e \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u0438 \u0430\u0432\u0430\u0442\u0430\u0440\u043e\u0432 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u043d\u0438\u043a\u043d\u0435\u0439\u043c\u0430",
    "type": "library",
    "license": "MIT",
    "version": "1.1.0",
    "require": {
        "php": "^8.5",
        "voral/joke": "^1.3",
        "ext-gd": "*"
    },
    "autoload": {
        "psr-4": {
            "Vasoft\\JokeAvatar\\": "src/"
        }
    },
    "scripts": {
        "dev": "php -S localhost:8000 -t public/",
        "test": "php vendor/bin/phpunit --display-warnings --display-all-issues",
        "cs": "php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --verbose",
        "cs:dry": "php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --verbose --dry-run",
        "stan": "php vendor/bin/phpstan analyse --configuration=.phpstan.neon.dist --memory-limit=256M",
        "stan:ci": "php vendor/bin/phpstan analyse --configuration=.phpstan.neon.dist --memory-limit=256M --no-progress --error-format=github",
        "vi:major": "php vendor/bin/vs-version-increment major",
        "vi:minor": "php vendor/bin/vs-version-increment minor",
        "vi:patch": "php vendor/bin/vs-version-increment patch",
        "vi:auto": "php vendor/bin/vs-version-increment",
        "vi:list": "php vendor/bin/vs-version-increment --list",
        "vi:debug": "php vendor/bin/vs-version-increment --debug"
    },
    "scripts-descriptions": {
        "dev": "\u0417\u0430\u043f\u0443\u0441\u043a \u0441\u0435\u0440\u0432\u0435\u0440\u0430 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0438 \u043d\u0430 http://localhost:8000",
        "test": "\u0417\u0430\u043f\u0443\u0441\u043a PHPUnit \u0442\u0435\u0441\u0442\u043e\u0432",
        "cs": "\u0417\u0430\u043f\u0443\u0441\u043a php-cs-fixer \u0434\u043b\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0438\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u043a\u043e\u0434\u0430",
        "cs:dry": "\u0417\u0430\u043f\u0443\u0441\u043a php-cs-fixer \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u0431\u0435\u0437 \u0432\u043d\u0435\u0441\u0435\u043d\u0438\u044f \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439",
        "stan": "\u0417\u0430\u043f\u0443\u0441\u043a PHPStan \u0441\u0442\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0430\u043d\u0430\u043b\u0438\u0437\u0430",
        "stan:ci": "\u0417\u0430\u043f\u0443\u0441\u043a PHPStan \u0434\u043b\u044f CI \u0441 GitHub \u0444\u043e\u0440\u043c\u0430\u0442\u043e\u043c \u043e\u0448\u0438\u0431\u043e\u043a",
        "vi:major": "\u0418\u043d\u043a\u0440\u0435\u043c\u0435\u043d\u0442 \u043c\u0430\u0436\u043e\u0440\u043d\u043e\u0439 \u0432\u0435\u0440\u0441\u0438\u0438 \u0438 \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 CHANGELOG.md",
        "vi:minor": "\u0418\u043d\u043a\u0440\u0435\u043c\u0435\u043d\u0442 \u043c\u0438\u043d\u043e\u0440\u043d\u043e\u0439 \u0432\u0435\u0440\u0441\u0438\u0438 \u0438 \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 CHANGELOG.md",
        "vi:patch": "\u0418\u043d\u043a\u0440\u0435\u043c\u0435\u043d\u0442 \u043f\u0430\u0442\u0447 \u0432\u0435\u0440\u0441\u0438\u0438 \u0438 \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 CHANGELOG.md",
        "vi:auto": "\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0432\u0435\u0440\u0441\u0438\u0438 \u0434\u043b\u044f \u0438\u043d\u043a\u0440\u0435\u043c\u0435\u043d\u0442\u0430 \u0438 \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 CHANGELOG.md",
        "vi:list": "\u0421\u043f\u0438\u0441\u043e\u043a \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u0442\u0438\u043f\u043e\u0432 \u043a\u043e\u043c\u043c\u0438\u0442\u043e\u0432 \u0438 \u0441\u043a\u043e\u0443\u043f\u043e\u0432",
        "vi:debug": "\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0432\u0435\u0440\u0441\u0438\u0438 \u0434\u043b\u044f \u0438\u043d\u043a\u0440\u0435\u043c\u0435\u043d\u0442\u0430 \u0438 \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 CHANGELOG.md \u0431\u0435\u0437 \u043a\u043e\u043c\u043c\u0438\u0442\u0430"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^13.1",
        "voral/version-increment": "^3.2"
    }
}